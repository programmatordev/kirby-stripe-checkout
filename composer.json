{
	"name": "programmatordev/kirby-stripe-checkout",
	"description": "Stripe Checkout for Kirby CMS",
	"type": "kirby-plugin",
    "license": "MIT",
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "stripe",
        "stripe-checkout"
    ],
    "homepage": "https://github.com/programmatordev/kirby-stripe-checkout",
    "support": {
        "issues": "https://github.com/programmatordev/kirby-stripe-checkout/issues",
        "source": "https://github.com/programmatordev/kirby-stripe-checkout"
    },
	"authors": [
		{
			"name": "Programmator",
			"email": "hotline@programmator.dev",
            "homepage": "https://programmator.dev"
		}
	],
	"require": {
        "php": ">=8.2.0",
		"getkirby/cms": "^5.0",
		"getkirby/composer-installer": "^1.2.1",
		"stripe/stripe-php": "^21.2",
		"symfony/options-resolver": "^7.2",
		"brick/money": "^0.14.1",
		"symfony/intl": "^7.2"
    },
    "require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpstan/phpstan": "^2.2",
		"phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
	"scripts": {
		"analyse": "phpstan analyse --no-progress",
		"check": [
			"@analyse",
			"@format:check",
			"@test"
		],
		"format": "php-cs-fixer fix",
		"format:check": "php-cs-fixer check --diff",
		"test": "phpunit"
	},
	"autoload": {
		"psr-4": {
			"ProgrammatorDev\\StripeCheckout\\": "src/"
		}
	},
    "autoload-dev": {
        "psr-4": {
            "ProgrammatorDev\\StripeCheckout\\Test\\": "tests/"
        }
    },
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	},
	"extra": {
		"kirby-cms-path": "kirby"
	}
}
