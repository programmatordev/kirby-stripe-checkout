# Copy these values to .ddev/.env for local Stripe test-mode integration.
# The committed placeholder values let the Kirby fixture boot without live credentials.
KIRBY_STRIPE_CHECKOUT_PUBLIC_KEY=pk_test_replace_me
KIRBY_STRIPE_CHECKOUT_SECRET_KEY=sk_test_replace_me
KIRBY_STRIPE_CHECKOUT_WEBHOOK_SECRET=whsec_replace_me
KIRBY_STRIPE_CHECKOUT_UI_MODE=hosted
